{
  "manifest_version": 3,
  "name": "Theater Mode for Google Meet",
  "version": "1.0",
  "description": "Screen shares fill the window, with movable camera previews and a video-only picture-in-picture.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/16-favicon.png",
    "32": "icons/32-windows.png",
    "48": "icons/48-extensions.png",
    "128": "icons/128-web-store.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Theater Mode"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["settings.js", "pip.js", "layout.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
